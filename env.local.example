# Local environment for portfolio-golam-sarowar. This file is git-ignored (.env*); never commit it.
# Use the same values in Vercel -> Settings -> Environment Variables for production.

# --- Supabase (required) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Contact form email via Gmail App Password (required for email notifications) ---
# GMAIL_USER: the Gmail address that sends the notifications
# GMAIL_APP_PASSWORD: 16-character App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Optional ---
# Inbox that receives contact notifications (defaults to GMAIL_USER)
CONTACT_TO=
# Sender display name (defaults to "Mohammad Golam Sarowar")
CONTACT_FROM_NAME=
# Canonical site URL for SEO metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://portfolio-golam-sarowar.vercel.app
# Redirect URL used after sign-up during local development
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/admin
